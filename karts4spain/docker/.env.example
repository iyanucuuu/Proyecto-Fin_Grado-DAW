# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env  (cp .env.example .env)  y rellena los valores.
# El archivo .env NUNCA debe subirse al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Frontend) ───────────────────────────────────────────────────────
# Encuéntralas en: Supabase > Settings > API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=TU_ANON_PUBLIC_KEY

# ── Base de datos PostgreSQL de Supabase (Backend) ───────────────────────────
# Encuéntralas en: Supabase > Settings > Database > Connection string (URI)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.TU_PROYECTO.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=TU_PASSWORD_DE_SUPABASE
